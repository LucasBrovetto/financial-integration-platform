# Development-only values used by docker-compose.yml.
POSTGRES_DB=financial_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_PORT=5432

# Application values when running transaction-service outside Docker.
DB_URL=jdbc:postgresql://localhost:5432/financial_platform
DB_USERNAME=postgres
DB_PASSWORD=12345
SERVER_PORT=8080
POS_PORT=5173
